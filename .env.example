# StoreWise Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration (Using SQLite for development)
DATABASE_URL="file:./dev.db"
# For PostgreSQL (alternative):
# DATABASE_URL="postgresql://username:password@localhost:5432/storewise"

# Server Configuration
NODE_ENV=development
PORT=3009

# Frontend Configuration
VITE_API_URL=http://localhost:3009/api
VITE_APP_NAME=StoreWise
VITE_APP_VERSION=1.0.0

# CORS Configuration
CORS_ORIGIN=http://localhost:3008

# File Upload (if implemented)
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Development Settings
SKIP_AUTH=true
ENABLE_MOCK_DATA=false